<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>LO_GlitterworldRecovery</defName>
    <label>Glitterworld Recovery</label>
    <description>Accelerated injury healing and immunity gain following treatment with glitterworld medicine.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <initialSeverity>1</initialSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>30000</disappearsAfterTicks>
      </li>
    </comps>
    <stages>
      <li>
        <statFactors>
          <InjuryHealingFactor>5</InjuryHealingFactor>
          <ImmunityGainSpeed>10</ImmunityGainSpeed>
        </statFactors>
      </li>
    </stages>
  </HediffDef>
</Defs>
